'use strict';

// 1. Google Tag Manager Initialization (Immediate)
window.dataLayer = window.dataLayer || [];
function gtag() { dataLayer.push(arguments); }
if (typeof dataLayer !== 'undefined') {
    gtag('js', new Date());
    gtag('config', 'G-ZM86G2MGE6');
}

// 2. Main Page Logic (wrapped in DOMContentLoaded)
document.addEventListener('DOMContentLoaded', () => {
    try {
        console.log("App.js: DOM Content Loaded. Initializing...");

        // Set Active Year mapping to global window
        window.ACTIVE_YEAR = parseInt(document.body.dataset.year) || 2026;
        console.log("App.js: ACTIVE_YEAR set to", window.ACTIVE_YEAR);

        // Routing Parameters
        const urlParams = new URLSearchParams(window.location.search);
        const idParam = urlParams.get('id');
        const nameParam = urlParams.get('name');
        console.log("App.js: idParam =", idParam, "nameParam =", nameParam);

        // Schedule Table Logic (index.html)
        const scheduleTable = document.getElementById('homeScheduleTable');
        if (scheduleTable) {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            scheduleTable.querySelectorAll('tr').forEach(row => {
                const dateCell = row.querySelector('[data-date]');
                const daysLeftCell = row.querySelector('.days-left');
                if (dateCell && daysLeftCell) {
                    const dateStr = dateCell.getAttribute('data-date');
                    const targetDate = new Date(dateStr + (dateStr.includes('T') ? '' : 'T00:00:00'));
                    const diffTime = targetDate - today;
                    const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));
                    if (diffDays > 0) {
                        daysLeftCell.textContent = diffDays + (diffDays === 1 ? ' Day' : ' Days');
                    } else if (diffDays === 0) {
                        daysLeftCell.textContent = 'Today';
                    } else {
                        daysLeftCell.textContent = 'Passed';
                        row.style.opacity = '0.6';
                    }
                }
            });
        }

        // Alliance Explorer (alliance.html)
        if (idParam && typeof window.renderAllianceExplorer === 'function' && document.getElementById('allianceCandTable')) {
            console.log("App.js: Executing renderAllianceExplorer for", idParam);
            window.renderAllianceExplorer(idParam);
        }
        
        // Alliances Summary (alliances.html)
        if (document.getElementById('allianceCards') && typeof window.renderAlliances === 'function') {
            console.log("App.js: Executing renderAlliances");
            window.renderAlliances();
        }

        // Constituency Detail Page (constituency.html)
        if ((nameParam || idParam) && typeof window.openSidebar === 'function' && document.getElementById('sidebarBody')) {
            const constituencyRef = nameParam || parseInt(idParam) || idParam;
            console.log("App.js: Executing openSidebar for", constituencyRef);
            window.openSidebar(constituencyRef);
        }

        // Parties Page (parties.html)
        if (document.getElementById('partyGrid') && typeof window.renderParties === 'function') {
            console.log("App.js: Executing renderParties");
            window.renderParties();
        }

        // Candidates Page Analytics (candidates.html)
        if (document.getElementById('homeAgeChart') && typeof window.renderCandidateAnalyticsCharts === 'function') {
            console.log("App.js: Executing renderCandidateAnalyticsCharts");
            window.renderCandidateAnalyticsCharts();
        }

        // Results Page (results.html)
        if (document.getElementById('allianceGroupResults') && typeof window.renderResults === 'function') {
            console.log("App.js: Executing renderResults");
            window.renderResults();
        }

        // Districts Page (results/district.html)
        if (document.getElementById('districtsGrid') && typeof window.renderDistricts === 'function') {
            console.log("App.js: Executing renderDistricts");
            window.renderDistricts();
        }

        // Party Detail Page (party.html)
        if (idParam && document.getElementById('partyDetailContainer') && typeof window.renderPartyDetail === 'function') {
            console.log("App.js: Executing renderPartyDetail for", idParam);
            window.renderPartyDetail(idParam);
        }

        // Global click listener (Data-driven triggers)
        document.addEventListener('click', (e) => {
            const target = e.target.closest('[data-trigger], [data-nav], [data-view]');
            if (!target) return;

            // 1. Navigation (data-nav)
            if (target.dataset.nav) {
                const path = target.dataset.nav;
                if (window.navigate) window.navigate(path);
                return;
            }

            // 2. Candidate Views (data-view)
            if (target.dataset.view) {
                const view = target.dataset.view;
                if (window.setCandView) window.setCandView(view);
                return;
            }

            // 3. Dynamic Triggers (data-trigger)
            if (target.dataset.trigger) {
                const action = target.dataset.trigger;
                const id = target.dataset.id;
                const arg = target.dataset.arg;

                if (action === 'openSidebar' && window.openConstituency) window.openConstituency(id);
                if (action === 'openCandModal' && window.openCandModal) window.openCandModal(id);
                if (action === 'openOthersModal' && window.openOthersModal) window.openOthersModal(id);
                if (action === 'openHistoryModal' && window.openHistoryModal) window.openHistoryModal(id);
                if (action === 'setManifestoSector' && window.setManifestoSector) window.setManifestoSector(arg);
                if (action === 'clearCandFilter' && window.clearCandFilter) window.clearCandFilter(arg);
                if (action === 'clearAllCandFilters' && window.clearAllCandFilters) window.clearAllCandFilters();
                if (action === 'toggleDistrictSort' && window.toggleDistrictSort) window.toggleDistrictSort(arg);
                if (action === 'clearSiteCache' && window.clearSiteCache) window.clearSiteCache();
                if (action === 'openConstituency' && window.openConstituency) window.openConstituency(id);
                if (action === 'openConstituencyBySearch' && window.openConstituencyBySearch) window.openConstituencyBySearch(arg);
                if (action === 'closeCandModal' && window.closeModal) window.closeModal();

                // Specific logic for district table toggle
                if (action === 'toggleDistrict') {
                    const rowIdx = target.dataset.index;
                    const rows = document.querySelectorAll('.acc-' + rowIdx);
                    if (rows.length > 0) {
                        const isHidden = rows[0].style.display === 'none';
                        rows.forEach(r => r.style.display = isHidden ? 'table-row' : 'none');
                        const icon = target.querySelector('.acc-icon');
                        if (icon) icon.textContent = isHidden ? '▼' : '▶';
                    }
                }

                if (action === 'closeSidebar' && window.closeSidebar) window.closeSidebar();
                if (action === 'closeCandModal' && (window.closeModal || window.closeCandModal)) { (window.closeModal || window.closeCandModal)(); }
                if (action === 'closeConstDetail' && window.closeConstDetail) window.closeConstDetail();
                if (action === 'closeOthersModal' && (window.closeModal || window.closeOthersModal)) { (window.closeModal || window.closeOthersModal)(); }
                if (action === 'shareSite') {
                    if (!window.openShareModal) {
                        window.openShareModal = function () {
                            let modal = document.getElementById('shareModal');
                            if (!modal) {
                                modal = document.createElement('div');
                                modal.id = 'shareModal';
                                modal.className = 'modal-overlay';
                                modal.style.zIndex = '3000';
                                modal.innerHTML = `
                                    <div class="modal" style="max-width:380px;">
                                        <div class="modal-header">
                                            <h3 style="margin:0;">Share This Site</h3>
                                            <button class="modal-close" onclick="window.closeShareModal()"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
                                        </div>
                                        <div class="share-modal-content">
                                            <div class="share-row-primary">
                                                <button class="share-option" onclick="window.shareTo('whatsapp')">
                                                    <div class="share-icon icon-whatsapp">
                                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12.011 20.304c-1.353 0-2.671-.358-3.824-1.036l-4.187 1.096 1.115-4.088c-.742-1.282-1.134-2.738-1.134-4.227 0-4.661 3.791-8.452 8.452-8.452s8.452 3.791 8.452 8.452-3.791 8.452-8.452 8.452zm0-15.352c-3.804 0-6.9 3.097-6.9 6.9 0 1.488.473 2.866 1.28 4.001l-.742 2.715 2.783-.728c1.087.683 2.355 1.045 3.579 1.045 3.804 0 6.9-3.097 6.9-6.9s-3.096-6.9-6.9-6.9zM15.42 13.911c-.199-.099-1.176-.58-1.358-.646-.182-.066-.314-.099-.447.099-.133.197-.513.646-.629.778-.115.133-.231.149-.43.049-.199-.099-.837-.309-1.593-.984-.589-.525-.987-1.173-1.103-1.371-.115-.197-.012-.304.087-.403.09-.089.199-.231.297-.346.099-.115.133-.197.199-.33.066-.131.033-.247-.016-.346-.05-.099-.447-1.071-.611-1.467-.159-.387-.323-.335-.447-.341-.115-.005-.247-.006-.379-.006-.133 0-.346.05-.528.247-.182.197-.694.677-.694 1.65 0 .973.71 1.914.81 2.046.099.133 1.398 2.135 3.387 2.992.473.204.842.326 1.13.418.475.149.907.128 1.248.077.38-.057 1.176-.481 1.341-.944.165-.463.165-.859.116-.944-.05-.085-.182-.132-.38-.232z"/></svg>
                                                    </div>
                                                    <span class="share-label">WhatsApp</span>
                                                </button>
                                                <button class="share-option" onclick="window.shareTo('x')">
                                                    <div class="share-icon icon-x">
                                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932 6.064-6.932zm-1.292 19.494h2.039L6.486 3.24H4.298l13.311 17.407z"/></svg>
                                                    </div>
                                                    <span class="share-label">𝕏</span>
                                                </button>
                                                <button class="share-option" onclick="window.shareTo('facebook')">
                                                    <div class="share-icon icon-facebook">
                                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.324v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
                                                    </div>
                                                    <span class="share-label">Facebook</span>
                                                </button>
                                                <button class="share-option" onclick="window.shareTo('telegram')">
                                                    <div class="share-icon icon-telegram">
                                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 24c6.627 0 12-5.373 12-12s-5.373-12-12-12-12 5.373-12 12 5.373 12 12 12zm0-22c5.523 0 10 4.477 10 10s-4.477 10-10 10-10-4.477-10-10 4.477-10 10-10zm.591 14.183l1.832-8.627c.101-.475-.178-.71-.53-.598l-10.748 4.144c-.452.174-.447.427-.08.539l2.755.86c.638.199 1.32.179 1.944-.055l6.45-4.307c.307-.205.589-.095.358.11l-5.214 4.706c-.253.228-.352.483-.245.727l1.458 3.251c.078.174.22.257.411.23.19-.027.327-.145.419-.311z"/></svg>
                                                    </div>
                                                    <span class="share-label">Telegram</span>
                                                </button>
                                                <button class="share-option" onclick="window.shareTo('instagram')">
                                                    <div class="share-icon icon-instagram">
                                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.17.054 1.805.249 2.227.412.558.217.957.477 1.377.896.419.42.679.819.896 1.377.163.422.358 1.057.412 2.227.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.054 1.17-.249 1.805-.412 2.227-.217.558-.477.957-.896 1.377-.42.419-.819.679-1.377.896-.422.163-1.057.358-2.227.412-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.17-.054-1.805-.249-2.227-.412-.558-.217-.957-.477-1.377-.896-.419-.42-.679-.819-.896-1.377-.163-.422-.358-1.057-.412-2.227-.058-1.266-.07-1.646-.07-4.85s.012-3.584.07-4.85c.054-1.17.249-1.805.412-2.227.217-.558.477-.957.896-1.377.42-.419.819-.679 1.377-.896.422-.163 1.057-.358 2.227-.412 1.266-.058 1.646-.07 4.85-.07m0-2.163c-3.259 0-3.667.014-4.947.072-1.277.058-2.148.261-2.911.558-.788.306-1.457.715-2.123 1.382-.667.666-1.076 1.335-1.382 2.123-.297.763-.5 1.634-.558 2.911-.058 1.28-.072 1.688-.072 4.947s.014 3.667.072 4.947c.058 1.277.261 2.148.558 2.911.306.788.715 1.457 1.382 2.123.666.667 1.335 1.076 2.123 1.382.763.297 1.634.5 2.911.558 1.28.058 1.688.072 4.947.072s3.667-.014 4.947-.072c1.277-.058 2.148-.261 2.911-.558.788-.306 1.457-.715 2.123-1.382.667-.666 1.076-1.335 1.382-2.123.297-.763.5-1.634.558-2.911.058-1.28.072-1.688.072-4.947s-.014-3.667-.072-4.947c-.058-1.277-.261-2.148-.558-2.911-.306-.788-.715-1.457-1.382-2.123-.666-.667-1.335-1.076-2.123-1.382-.763-.297-1.634-.5-2.911-.558-1.28-.058-1.688-.072-4.947-.072zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.791-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.209-1.791 4-4 4zm6.406-11.845c0 .796-.646 1.442-1.442 1.442-.797 0-1.442-.646-1.442-1.442 0-.797.645-1.442 1.442-1.442.796 0 1.442.645 1.442 1.442z"/></svg>
                                                    </div>
                                                    <span class="share-label">Instagram</span>
                                                </button>
                                            </div>
                                            <div class="share-row-secondary">
                                                <button class="share-action-btn" onclick="window.shareTo('copy')">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                                    Copy Link
                                                </button>
                                                <button class="share-action-btn" id="nativeShareBtn" onclick="window.shareTo('system')">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                                                    Share to Others
                                                </button>
                                            </div>
                                        </div>
                                        <div id="copyFeedback" class="copy-feedback">Link Copied!</div>
                                    </div>`;
                                document.body.appendChild(modal);

                                // Generic close on overlay click
                                modal.addEventListener('click', (e) => {
                                    if (e.target === modal) window.closeShareModal();
                                });

                                // Check for native share support
                                if (navigator.share) {
                                    document.getElementById('nativeShareBtn').style.display = 'flex';
                                }
                            }

                            window.shareTo = (platform) => {
                                const title = "Tamil Nadu Elections 2026 Dashboard";
                                const text = "Track official candidates, seat shares, and election data for Tamil Nadu Assembly Election 2026: ";
                                const url = "https://tnelections2026.in" || window.location.origin;

                                if (platform === 'whatsapp') {
                                    window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text + url)}`, '_blank');
                                } else if (platform === 'x') {
                                    window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url)}`, '_blank');
                                } else if (platform === 'facebook') {
                                    window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, '_blank');
                                } else if (platform === 'telegram') {
                                    window.open(`https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(text)}`, '_blank');
                                } else if (platform === 'instagram') {
                                    if (navigator.share) {
                                        window.shareTo('system');
                                    } else {
                                        window.shareTo('copy');
                                        alert("Link copied! Open Instagram to share this site in your story or message.");
                                    }
                                } else if (platform === 'copy') {
                                    navigator.clipboard.writeText(url).then(() => {
                                        const feedback = document.getElementById('copyFeedback');
                                        feedback.classList.add('active');
                                        setTimeout(() => feedback.classList.remove('active'), 2000);
                                    });
                                } else if (platform === 'system') {
                                    if (navigator.share) {
                                        navigator.share({ title, text, url }).catch(err => {
                                            if (err.name !== 'AbortError') console.error('Error sharing:', err);
                                        });
                                    }
                                }
                            };

                            // Initial state check
                            const nativeBtn = document.getElementById('nativeShareBtn');
                            if (!navigator.share && nativeBtn) {
                                nativeBtn.style.display = 'none';
                            }

                            modal.style.display = 'flex';
                            setTimeout(() => modal.classList.add('active'), 10);
                        };

                        window.closeShareModal = function () {
                            const modal = document.getElementById('shareModal');
                            if (modal) {
                                modal.classList.remove('active');
                                setTimeout(() => modal.style.display = 'none', 300);
                            }
                        };
                    }
                    window.openShareModal();
                }

                return;
            }

            // 4. Close Handlers
            if (e.target.matches('.modal-close, .sidebar-close')) {
                if (window.closeModal && e.target.closest('.modal-overlay')) window.closeModal();
                else if (window.closeSidebar && e.target.closest('.sidebar-overlay')) window.closeSidebar();
            }
        });

        // Global listeners for 'change' events
        document.addEventListener('change', (e) => {
            const target = e.target.closest('[data-change]');
            if (target) {
                const action = target.dataset.change;
                if (action === 'home' && window.renderHomeAlliance) window.renderHomeAlliance();
                if (action === 'results' && window.renderPageResultsChart) window.renderPageResultsChart();
            }
        });

        // Global listeners for 'input' events
        document.addEventListener('input', (e) => {
            const target = e.target.closest('[data-input]');
            if (target) {
                const action = target.dataset.input;
                if (action === 'manifesto' && window.filterManifesto) window.filterManifesto();
            }
        });

        // Handle Datawrapper Height Adjustments & Theme Sync
        window.addEventListener("message", function (a) {
            if (void 0 !== a.data["datawrapper-height"]) {
                var e = document.querySelectorAll("iframe");
                const isDark = document.documentElement.classList.contains('dark-mode') || document.body.classList.contains('dark-mode');
                const theme = isDark ? 'dark' : 'light';
                
                for (var t in a.data["datawrapper-height"]) {
                    for (var r, i = 0; r = e[i]; i++) {
                        if (r.contentWindow === a.source) {
                            var d = a.data["datawrapper-height"][t] + "px";
                            r.style.height = d;

                            // Sync theme to Datawrapper (multiple attempts to ensure listener is ready)
                            const sendTheme = () => {
                                r.contentWindow.postMessage({ "datawrapper-theme": theme }, "*");
                            };
                            setTimeout(sendTheme, 100);
                            setTimeout(sendTheme, 500);
                            setTimeout(sendTheme, 2000);
                        }
                    }
                }
            }
        });

        const genericClose = document.getElementById('closeGenericModal');
        if (genericClose) {
            genericClose.addEventListener('click', () => {
                if (window.closeModal) window.closeModal();
            });
        }

        // Global Image Fallback Handler (CSP-compliant replacement for onerror)
        document.addEventListener('error', (e) => {
            const t = e.target;
            if (t.tagName !== 'IMG') return;

            // Party Icon fallback
            if (t.classList.contains('party-icon')) {
                t.style.display = 'none';
            }

            // Constituency Map fallback
            if (t.dataset.fallback === 'const-map') {
                if (t.src.includes('Constitution-')) {
                    // Try simple name fallback
                    const alt = t.alt || "";
                    const namePart = alt.split('highlighting ')[1] || "";
                    const name = namePart.split(' Constituency')[0].replace(/ /g, '_');
                    if (name) t.src = getAssetUrl(`assets/maps/${name}.svg`);
                } else {
                    t.style.display = 'none';
                    if (t.nextElementSibling) t.nextElementSibling.style.display = 'block';
                }
            }
        }, true);

        // 5. Custom Tooltip Logic
        if (window.matchMedia('(pointer: fine)').matches) {
            const tt = document.createElement('div');
            tt.id = 'custom-tooltip';
            document.body.appendChild(tt);

            const updateTTPos = (e) => {
                let x = e.clientX + 12;
                let y = e.clientY + 12;
                if (x + tt.offsetWidth > window.innerWidth) x = e.clientX - tt.offsetWidth - 12;
                if (y + tt.offsetHeight > window.innerHeight) y = e.clientY - tt.offsetHeight - 12;
                tt.style.left = x + 'px';
                tt.style.top = y + 'px';
            };

            document.addEventListener('mouseover', (e) => {
                const target = e.target.closest('[data-tooltip]');
                if (target) {
                    tt.textContent = target.dataset.tooltip;
                    tt.classList.add('visible');
                    updateTTPos(e);
                }
            });

            document.addEventListener('mousemove', (e) => {
                if (tt.classList.contains('visible')) updateTTPos(e);
            });

            document.addEventListener('mouseout', (e) => {
                if (e.target.closest('[data-tooltip]')) {
                    tt.classList.remove('visible');
                }
            });
        }



    } catch (err) {
        console.error("App.js: ERROR during initialization:", err);
    }
});
