function resolveCandidateImage(can) {
  if (!can) return 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><defs><linearGradient id=%22g%22 x1=%220%%22 y1=%220%%22 x2=%22100%%22 y2=%22100%%22><stop offset=%220%%22 stop-color=%22%231e293b%22/><stop offset=%22100%%22 stop-color=%22%230f172a%22/></linearGradient></defs><rect width=%22100%22 height=%22100%22 fill=%22url(%23g)%22/><circle cx=%2250%22 cy=%2238%22 r=%2218%22 fill=%22%23cbd5e1%22 opacity=%220.15%22/><path d=%22M50 60c-18 0-30 8-30 18v8h60v-8c0-10-12-18-30-18z%22 fill=%22%23cbd5e1%22 opacity=%220.15%22/></svg>';
  
  if (typeof CANDIDATE_IMAGE_MANIFEST !== 'undefined' && can.id && CANDIDATE_IMAGE_MANIFEST[can.id]) {
    const path = CANDIDATE_IMAGE_MANIFEST[can.id];
    return typeof getAssetUrl !== 'undefined' ? getAssetUrl(path) : 'https://pub-b25d504a24b04494839eefe88766f3e8.r2.dev/' + path;
  }
  
  const gender = (can.gender || '').toLowerCase();
  if (gender.includes('female')) {
    return 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><defs><linearGradient id=%22g%22 x1=%220%%22 y1=%220%%22 x2=%22100%%22 y2=%22100%%22><stop offset=%220%%22 stop-color=%22%231e293b%22/><stop offset=%22100%%22 stop-color=%22%230f172a%22/></linearGradient></defs><rect width=%22100%22 height=%22100%22 fill=%22url(%23g)%22/><circle cx=%2250%22 cy=%2238%22 r=%2216%22 fill=%22%23cbd5e1%22 opacity=%220.15%22/><path d=%22M50 58c-15 0-26 8-28 17v11h56v-11c-2-9-13-17-28-17z%22 fill=%22%23cbd5e1%22 opacity=%220.15%22/></svg>';
  }
  if (gender.includes('trans') || gender.includes('third') || gender.includes('other')) {
    return 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><defs><linearGradient id=%22g%22 x1=%220%%22 y1=%220%%22 x2=%22100%%22 y2=%22100%%22><stop offset=%220%%22 stop-color=%22%231e293b%22/><stop offset=%22100%%22 stop-color=%22%230f172a%22/></linearGradient></defs><rect width=%22100%22 height=%22100%22 fill=%22url(%23g)%22/><circle cx=%2250%22 cy=%2238%22 r=%2217%22 fill=%22%23cbd5e1%22 opacity=%220.15%22/><path d=%22M50 59c-16 0-28 8-29 17v10h58v-10c-1-9-13-17-29-17z%22 fill=%22%23cbd5e1%22 opacity=%220.15%22/></svg>';
  }
  return 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><defs><linearGradient id=%22g%22 x1=%220%%22 y1=%220%%22 x2=%22100%%22 y2=%22100%%22><stop offset=%220%%22 stop-color=%22%231e293b%22/><stop offset=%22100%%22 stop-color=%22%230f172a%22/></linearGradient></defs><rect width=%22100%22 height=%22100%22 fill=%22url(%23g)%22/><circle cx=%2250%22 cy=%2238%22 r=%2218%22 fill=%22%23cbd5e1%22 opacity=%220.15%22/><path d=%22M50 60c-18 0-30 8-30 18v8h60v-8c0-10-12-18-30-18z%22 fill=%22%23cbd5e1%22 opacity=%220.15%22/></svg>';
}







// Helper: Resolve constituency name from candidate (acNo lookup or legacy .constituency)
function candConst(cand) {
  if (cand.constituency) return cand.constituency;
  if (cand.acNo && typeof TN_CONSTITUENCIES_234 !== 'undefined') {
    const ac = TN_CONSTITUENCIES_234.find(c => c.id === cand.acNo);
    if (ac) return ac.name;
  }
  return '';
}

function renderCategoryBadge(cat) {
  if (!cat) return '';
  const isGen = cat.toLowerCase() === 'general';
  const label = isGen ? 'GEN' : cat;
  const tooltip = isGen ? 'data-tooltip="General (Non-reserved)"' : (cat.toLowerCase() === 'sc' ? 'data-tooltip="Scheduled Caste (Reserved)"' : 'data-tooltip="Scheduled Tribe (Reserved)"');
  const cls = cat.toLowerCase() === 'sc' ? 'badge-sc' : (cat.toLowerCase() === 'st' ? 'badge-st' : 'badge-gen');
  return `<span class="badge-cat ${cls}" ${tooltip}>${label}</span>`;
}

// Helper: Contrast color
function getContrastColor(color) {
  if (!color || color === 'transparent') return '#333';
  if (color.startsWith('var')) return '#333';
  let hex = color.replace('#', '');
  if (hex.length === 3) hex = hex.split('').map(x => x + x).join('');
  const r = parseInt(hex.substr(0, 2), 16);
  const g = parseInt(hex.substr(2, 2), 16);
  const b = parseInt(hex.substr(4, 2), 16);
  const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
  return luminance > 0.5 ? '#000' : '#fff';
}

function renderGenderVisual(gender) {
  if (!gender) return '';
  const g = gender.toLowerCase();
  if (g.includes('female')) {
    return `<span class="gender-visual gender-female">♀ Female</span>`;
  } else if (g.includes('male')) {
    return `<span class="gender-visual gender-male">♂ Male</span>`;
  } else if (g.includes('trans') || g.includes('third') || g.includes('other')) {
    return `<span class="gender-visual gender-other">⚤ Third Gender</span>`;
  }
  return gender;
}

function getGenderStyle(gender) {
  // Keeping this for compatibility but preferred is CSS class
  if (!gender) return '';
  const g = gender.toLowerCase();
  if (document.documentElement.classList.contains('dark-mode')) {
    if (g.includes('female')) return 'color: #F06292;';
    if (g.includes('third') || g.includes('trans') || g.includes('other')) return 'color: #BA68C8;';
    if (g.includes('male')) return 'color: #64B5F6;';
  } else {
    if (g.includes('female')) return 'color: #c2185b;';
    if (g.includes('third') || g.includes('trans') || g.includes('other')) return 'color: #7b1fa2;';
    if (g.includes('male')) return 'color: #1565c0;';
  }
  return '';
}

function cleanGender(g) {
  if (!g) return '';
  // Strip all non-ASCII characters (emojis, symbols) to keep UI clean
  return g.replace(/[^\x00-\x7F]/g, '').trim();
}

'use strict';

// ── Active charts registry (to destroy before re-render) ──
const activeCharts = {};

function destroyChart(id) {
  if (activeCharts[id]) { activeCharts[id].destroy(); delete activeCharts[id]; }
}

function mkChart(id, config) {
  if (typeof ApexCharts === 'undefined') {
    console.error("ApexCharts not found. Check CDN link.");
    return;
  }
  destroyChart(id);
  const el = document.getElementById(id);
  if (!el) return;

  // Accessibility
  if (!el.getAttribute('aria-label')) {
    const card = el.closest('.card, .kpi, .sidebar-panel');
    const titleEl = card ? card.querySelector('h1, h2, h3, .kpi-label, .sidebar-title') : null;
    const label = titleEl ? titleEl.textContent.trim() : "Election Chart";
    el.setAttribute('aria-label', label);
  }
  el.setAttribute('role', 'img');

  try {

    // Map Chart.js types to Apex
    let apexType = config.type === 'doughnut' ? 'donut' : config.type;
    if (apexType === 'line' && config.options && config.options.fill) apexType = 'area';

    const isDoughnut = apexType === 'donut' || apexType === 'pie';
    const isBar = apexType === 'bar';

    const isDark = document.documentElement.classList.contains('dark-mode');
    const chartGrey = isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.05)';
    const textGrey = isDark ? 'rgba(255, 255, 255, 0.6)' : 'rgba(0, 0, 0, 0.6)';

    const options = {
      chart: {
        type: apexType,
        height: '100%',
        fontFamily: 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif',
        toolbar: { show: false },
        zoom: { enabled: false },
        background: 'transparent'
      },
      theme: {
        mode: isDark ? 'dark' : 'light'
      },
      grid: {
        borderColor: chartGrey,
        strokeDashArray: 4,
        xaxis: { lines: { show: false } },
        yaxis: { lines: { show: isBar } },
        padding: { top: 0, right: 0, bottom: 0, left: 10 }
      },
      xaxis: {
        axisBorder: { show: true, color: chartGrey },
        axisTicks: { show: true, color: chartGrey },
        labels: { style: { colors: textGrey, fontSize: '11px' } }
      },
      yaxis: {
        axisBorder: { show: true, color: chartGrey },
        axisTicks: { show: true, color: chartGrey },
        labels: { style: { colors: textGrey, fontSize: '11px' } }
      },
      dataLabels: {
        enabled: false,
        formatter: (val, opt) => {
          if (isDoughnut) {
            const label = opt.w.globals.labels[opt.seriesIndex];
            const value = opt.w.globals.series[opt.seriesIndex];
            return label + ': ' + (typeof value === 'number' ? value.toLocaleString('en-IN') : value);
          }
          return typeof val === 'number' && val > 1000 ? fmtLacs(val) : val;
        },
        style: { fontSize: '10px', fontWeight: '800' }
      },
      tooltip: {
        theme: isDark ? 'dark' : 'light',
        y: { formatter: v => typeof v === 'number' ? v.toLocaleString('en-IN') : v }
      },
      legend: { show: false },
      colors: [],
      series: [],
      labels: []
    };

    if (isDoughnut) {
      options.series = config.data.datasets[0].data;
      options.labels = config.data.labels;
      options.colors = config.data.datasets[0].backgroundColor;

      // Handle Gauge/Semi-circle mapping from Chart.js style
      let startAngle = 0;
      let endAngle = 360;
      if (config.options) {
        if (config.options.chart && config.options.chart.stacked) options.chart.stacked = true;
        if (config.options.circumference === 180) {
          if (config.options.rotation === -90) { startAngle = -90; endAngle = 90; }
          else if (config.options.rotation === 0) { startAngle = 0; endAngle = 180; }
        }
      }

      options.plotOptions = {
        pie: {
          donut: { size: '70%', background: 'transparent' },
          startAngle: startAngle,
          endAngle: endAngle,
          offsetY: (endAngle - startAngle === 180) ? 20 : 0
        }
      };

      options.grid = { padding: { bottom: (endAngle - startAngle === 180) ? -60 : 0 } };
      options.dataLabels.dropShadow = { enabled: false };
      options.stroke = { show: true, width: 1.5, colors: ['var(--surface)'] };
    } else if (isBar) {
      options.series = config.data.datasets.map(ds => ({
        name: ds.label || 'Count',
        data: ds.data
      }));
      options.xaxis = { categories: config.data.labels };

      // Map colors
      const ds0 = config.data.datasets[0];
      if (Array.isArray(ds0.backgroundColor)) {
        options.colors = ds0.backgroundColor;
        options.plotOptions = { bar: { distributed: true } };
      } else {
        options.colors = config.data.datasets.map(ds => ds.backgroundColor);
      }

      if (config.options && config.options.indexAxis === 'y') {
        if (!options.plotOptions) options.plotOptions = {};
        if (!options.plotOptions.bar) options.plotOptions.bar = {};
        options.plotOptions.bar.horizontal = true;
      }
    } // Close isBar block

    if (config.options) {
      if (config.options.plotOptions) {
        options.plotOptions = { ...options.plotOptions, ...config.options.plotOptions };
      }
      if (config.options.dataLabels) {
        options.dataLabels = { ...options.dataLabels, ...config.options.dataLabels };
      }
      if (config.options.layout) options.layout = config.options.layout;
      if (config.options.grid) options.grid = config.options.grid;
      if (config.options.legend) options.legend = { ...options.legend, ...config.options.legend };
      // Also check plugins.legend (Chart.js style)
      if (config.options.plugins && config.options.plugins.legend) {
        const cl = config.options.plugins.legend;
        options.legend = { show: cl.display !== false, position: cl.position || 'bottom' };
      }
    }
    const chart = new ApexCharts(el, options);
    chart.render();
    activeCharts[id] = chart;
    return chart;
  } catch (err) {
    console.error("Error creating chart", id, err);
  }
}

