          REFRESH SITE FOR UPDATES
        </button>
      </div>
    </div>
  `;

  // Attach direct listener to ensure functionality (bypassing potentially broken app.js delegation)
  setTimeout(() => {
    const btn = document.getElementById('refreshSiteButton');
    if (btn) {
      btn.addEventListener('click', () => {
        if (typeof window.clearSiteCache === 'function') {
          window.clearSiteCache();
        }
      });
    }
  }, 100);
}

// Global Cache Cleaner
window.clearSiteCache = function () {
  if (confirm('Clear local cache and refresh to see latest updates?')) {
    if ('caches' in window) {
      caches.keys().then(names => {
        for (let name of names) caches.delete(name);
      });
    }
    const cookies = document.cookie.split(";");
    for (let i = 0; i < cookies.length; i++) {
      const cookie = cookies[i];
      const eqPos = cookie.indexOf("=");
      const name = eqPos > -1 ? cookie.substr(0, eqPos) : cookie;
      document.cookie = name + "=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/";
    }
    localStorage.clear();
    sessionStorage.clear();
    window.location.reload(true);
  }
}

window.renderAllianceExplorer = function (allianceId) {
  const alliance = (TN_DATA.alliances || []).find(a => a.id === allianceId);
  if (!alliance) return;

  const pageTitle = document.getElementById('alliancePageTitle');
  const pageSub = document.getElementById('alliancePageSub');
  if (pageTitle) pageTitle.textContent = `${alliance.name} Candidates Explorer`;
  if (pageSub) pageSub.innerHTML = `Full list of <b>${alliance.seatsContested}</b> candidates contesting under the ${alliance.name} alliance across Tamil Nadu.`;

  const candidates = (typeof TN_CANDIDATES !== 'undefined' ? TN_CANDIDATES : []).filter(c => c.alliance === alliance.id);
  const distSelect = document.getElementById('allianceDistFilter');
  const partySelect = document.getElementById('alliancePartyFilter');
  const searchInput = document.getElementById('allianceCandSearch');
  const tableBody = document.getElementById('allianceCandBody');

  if (!tableBody) return;

  // Populate filter options
  const districts = [...new Set(candidates.map(c => c.district))].sort();
  districts.forEach(d => {
    const opt = document.createElement('option');
    opt.value = d;
    opt.textContent = d;
    distSelect.appendChild(opt);
  });

  const parties = [...new Set(candidates.map(c => getPartyCode(c.party)))].sort();
  parties.forEach(p => {
    const opt = document.createElement('option');
    opt.value = p;
    opt.textContent = p;
    partySelect.appendChild(opt);
  });

  const renderTable = () => {
    const query = (searchInput.value || "").toLowerCase();
    const distFilter = distSelect.value;
    const partyFilter = partySelect.value;

    const filtered = candidates.filter(c => {
      const matchSearch = (c.name || "").toLowerCase().includes(query) ||
        (candConst(c) || "").toLowerCase().includes(query) ||
        (getPartyName(c.party) || "").toLowerCase().includes(query) || (getPartyCode(c.party) || "").toLowerCase().includes(query);
      const matchDist = distFilter === 'all' || c.district === distFilter;
      const matchParty = partyFilter === 'all' || getPartyCode(c.party) === partyFilter;
      return matchSearch && matchDist && matchParty;
    });

    if (filtered.length === 0) {
      tableBody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding: 3rem; color:var(--text-3); font-style:italic;">No candidates found matching your criteria.</td></tr>`;
      return;
    }

    tableBody.innerHTML = filtered.map(c => {
      const constInfo = TN_DATA.constituencies.find(ac => ac.id === c.acNo);
      return `
        <tr class="hover-surface" style="font-size: 0.875rem;">
          <td data-label="AC No." data-trigger="openConstituency" data-id="${c.acNo || (constInfo ? constInfo.id : '')}" class="clickable" style="text-align:center; font-weight:700; color:var(--text-3); font-family:var(--font-mono);">${c.acNo || (constInfo ? constInfo.id : '-')}</td>
          <td data-label="Constituency" data-trigger="openConstituency" data-id="${c.acNo || (constInfo ? constInfo.id : '')}" class="clickable" style="font-weight:700; color:var(--accent-2);">${candConst(c)}</td>
          <td data-label="Party">
            <span class="badge" style="background:${alliance.color}15; color:${alliance.color}; border:1px solid ${alliance.color}30;">${renderPartyCode(c.party)}</span>
          </td>
          <td data-label="G" style="text-align:center;">
             ${renderGenderVisual(c.gender) ? `<div style="${getGenderStyle(c.gender)} width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">${renderGenderVisual(c.gender)}</div>` : '-'}
          </td>
          <td data-label="Candidate" data-trigger="openCandModal" data-id="${c.id}" class="clickable" style="font-weight:700;">
            <span style="${getGenderStyle(c.gender)} text-decoration: underline; text-decoration-style: dotted; text-underline-offset: 4px;">${c.name}</span>
          </td>
          <td data-label="Age" style="color:var(--text-2); font-weight:500;">${c.age || '-'}</td>
          <td data-label="Education" style="color:var(--text-2); font-weight:500;">${c.education || '-'}</td>
          <td data-label="District" style="color:var(--text-2); font-weight:500;">${c.district}</td>
        </tr>
      `;
    }).join('');

  };

  searchInput.addEventListener('input', renderTable);
  distSelect.addEventListener('change', renderTable);
  partySelect.addEventListener('change', renderTable);
  renderTable();
};

/* ── Generic Table Sorting ───────────────────────── */
document.addEventListener('click', e => {
  const th = e.target.closest('.data-table th');
  if (!th || th.closest('.manifesto-table')) return;

  const table = th.closest('table');
  const tbody = table.querySelector('tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));
  const columnIndex = Array.from(th.parentNode.children).indexOf(th);
  const isAscending = th.dataset.sortDir !== 'asc';

  // Reset other headers
  table.querySelectorAll('th').forEach(h => {
    if (h !== th) {
      delete h.dataset.sortDir;
      h.classList.remove('sort-asc', 'sort-desc');
    }
  });

  th.dataset.sortDir = isAscending ? 'asc' : 'desc';
  th.classList.toggle('sort-asc', isAscending);
  th.classList.toggle('sort-desc', !isAscending);

  const getVal = (row) => row.children[columnIndex].innerText || row.children[columnIndex].textContent;

  rows.sort((a, b) => {
    const valA = getVal(a).trim();
    const valB = getVal(b).trim();

    // Check if numeric (stripping non-numeric prefixes like 'AC: ')
    const stripNonNumeric = (s) => s.replace(/,/g, '').replace(/[^-0-9.]/g, '');
    const numA = parseFloat(stripNonNumeric(valA));
    const numB = parseFloat(stripNonNumeric(valB));

    if (!isNaN(numA) && !isNaN(numB)) {
      return isAscending ? numA - numB : numB - numA;
    }

    return isAscending ? valA.localeCompare(valB) : valB.localeCompare(valA);
  });

  tbody.innerHTML = '';
  rows.forEach(row => tbody.appendChild(row));
});



/**
 * Renders the full constituency results table with search.
 */
window.renderResultsFullTable = function () {
    const tbl = document.getElementById('resultsFullTable');
    if (!tbl) return;

    const searchInput = document.getElementById('resultsTableSearch');
    const distFilter = document.getElementById('resultsDistrictFilter');
    const partyFilter = document.getElementById('resultsPartyFilter');
    const allianceFilter = document.getElementById('resultsAllianceFilter');

    const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
    const selDist = distFilter ? distFilter.value : '';
    const selParty = partyFilter ? partyFilter.value : '';
    const selAlliance = allianceFilter ? allianceFilter.value : '';

    const resultsDraft = (typeof RESULTS_2026_DRAFT !== 'undefined' && RESULTS_2026_DRAFT.constituency_results) 
                        ? RESULTS_2026_DRAFT.constituency_results 
                        : {};

    const allianceMap = {
      'TVK':'TVK','DMK':'DMK+','INC':'DMK+','VCK':'DMK+','CPI':'DMK+',
      'CPIM':'DMK+','IUML':'DMK+','MDMK':'DMK+','DMDK':'DMK+',
      'ADMK':'ADMK+','PMK':'ADMK+','BJP':'ADMK+','AMMK':'ADMK+',
      'NTK':'NTK','MNM':'MNM'
    };

    // 1. Populate Dropdowns if not done
    if (distFilter && distFilter.options.length <= 1) {
      const districts = [...new Set(TN_DATA.constituencies.map(c => c.district))].sort();
      districts.forEach(d => {
        const opt = document.createElement('option');
        opt.value = d; opt.textContent = d;
        distFilter.appendChild(opt);
      });
    }
    if (partyFilter && partyFilter.options.length <= 1) {
      const parties = [...new Set(Object.values(resultsDraft).map(r => r.party).filter(p => p && p !== '—'))].sort();
      parties.forEach(p => {
        const opt = document.createElement('option');
        opt.value = p; opt.textContent = p;
        partyFilter.appendChild(opt);
      });
    }

    // 2. Add Listeners
    [searchInput, distFilter, partyFilter, allianceFilter].forEach(el => {
      if (el && !el.dataset.listener) {
        el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', () => window.renderResultsFullTable());
        el.dataset.listener = "true";
      }
    });

    // 3. Filter Data
    const data = TN_DATA.constituencies.filter(c => {
        const res = resultsDraft[c.id] || null;
        const party = res ? res.party : '—';
        const aName = party !== '—' ? (allianceMap[party] || 'Others') : '—';

        const matchesSearch = c.name.toLowerCase().includes(query) || c.id.toString() === query;
        const matchesDist = !selDist || c.district === selDist;
        const matchesParty = !selParty || party === selParty;
        const matchesAlliance = !selAlliance || aName === selAlliance;

        return matchesSearch && matchesDist && matchesParty && matchesAlliance;
    });

    // 4. Render Summary Chips
    const chipContainer = document.getElementById('resultsFilterChips');
    if (chipContainer) {
        const partyCounts = {};
        data.forEach(c => {
            const res = resultsDraft[c.id] || null;
            const party = res ? res.party : '—';
            if (party && party !== '—') {
                partyCounts[party] = (partyCounts[party] || 0) + 1;
            }
        });

        const sortedParties = Object.keys(partyCounts).sort((a, b) => partyCounts[b] - partyCounts[a]);
        chipContainer.innerHTML = sortedParties.map(p => {
            const color = partyColor(p);
            return `
                <div style="display:flex; align-items:center; gap:6px; padding:5px 12px; border-radius:20px; background:${color}15; border:1px solid ${color}35; font-size:0.75rem; font-weight:800; color:${color};">
                    <img src="${partyIcon(p)}" style="width:14px; height:14px; object-fit:contain;" onerror="this.style.display='none'">
                    <span>${p}: ${partyCounts[p]}</span>
                </div>
            `;
        }).join('');
    }

    const allianceColorMap = {
      'TVK':'#A67C00','DMK+':'#E53935','ADMK+':'#43A047','NTK':'#b31818','MNM':'#00838F'
    };

    tbl.innerHTML = `
        <thead>
            <tr>
                <th style="width: 50px; text-align: center;">No.</th>
                <th>Constituency</th>
                <th style="text-align: left;">Elected Candidate</th>
                <th style="text-align: center;">Party</th>
                <th style="text-align: right;">Margin</th>
                <th style="text-align: center;">Alliance</th>
            </tr>
        </thead>
        <tbody>
            ${data.map(c => {
                const res = resultsDraft[c.id] || null;
                const party = res ? res.party : '—';
                const candidate = res && res.candidate && res.candidate !== '—' ? res.candidate : '—';
                const margin = res && res.margin && res.margin !== '—' ? Number(res.margin).toLocaleString('en-IN') : '—';
                const partyColorStyle = party !== '—' ? `color: ${partyColor(party)}; font-weight: 800;` : '';
                const aName = party !== '—' ? (allianceMap[party] || 'Others') : '—';
                const allianceColor = allianceColorMap[aName] || 'var(--text-3)';
                const allianceBadge = aName !== '—'
                  ? `<span style="font-size:0.65rem; font-weight:800; padding:3px 10px; border-radius:20px; background:${allianceColor}18; color:${allianceColor}; border:1px solid ${allianceColor}35; white-space:nowrap;">${aName}</span>`
                  : `<span style="color:var(--text-3);">—</span>`;

                return `
                    <tr class="clickable" data-trigger="openConstituency" data-id="${c.id}">
                        <td style="text-align: center; color: var(--text-3); font-weight: 700;">${c.id}</td>
                        <td>
                            <div style="font-weight: 700;">${c.name}</div>
                            <div style="font-size: 0.65rem; color: var(--text-3); font-weight: 600;">${c.district}</div>
                        </td>
                        <td style="font-weight: 700; color: var(--text);">${candidate}</td>
                        <td style="text-align: center;">
                          <div style="display:flex; align-items:center; justify-content:center; gap:5px;">
                            ${party !== '—' ? `<img src="${partyIcon(party)}" style="width:18px; height:18px; object-fit:contain;" onerror="this.style.display='none'">` : ''}
                            <span style="${partyColorStyle}">${party}</span>
                          </div>
                        </td>
                        <td style="text-align: right; font-weight: 700; color: var(--text-2); font-family: var(--font-mono);">${margin}</td>
                        <td style="text-align: center;">${allianceBadge}</td>
                    </tr>
                `;
            }).join('') || `<tr><td colspan="6" style="text-align: center; padding: 3rem; color: var(--text-3);">No results found</td></tr>`}
        </tbody>
    `;
};
/**
 * Renders the Won MLAs table.
 */
window.renderMLAs = function () {
    const tbl = document.getElementById('mlaFullTable');
    if (!tbl) return;

    const searchInput = document.getElementById('mlaSearch');
    const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

    const resultsDraft = (typeof RESULTS_2026_DRAFT !== 'undefined' && RESULTS_2026_DRAFT.constituency_results) 
                        ? RESULTS_2026_DRAFT.constituency_results 
                        : {};

    const allianceMap = {
      'TVK':'TVK','DMK':'DMK+','INC':'DMK+','VCK':'DMK+','CPI':'DMK+',
      'CPIM':'DMK+','IUML':'DMK+','MDMK':'DMK+','DMDK':'DMK+',
      'ADMK':'ADMK+','PMK':'ADMK+','BJP':'ADMK+','AMMK':'ADMK+',
      'NTK':'NTK','MNM':'MNM'
    };

    const allianceColorMap = {
      'TVK':'#A67C00','DMK+':'#E53935','ADMK+':'#43A047','NTK':'#b31818','MNM':'#00838F'
    };

    // Filter to only include WON results
    const data = TN_DATA.constituencies.filter(c => {
        const res = resultsDraft[c.id] || null;
        if (!res || !res.isWon) return false;

        const matchesSearch = c.name.toLowerCase().includes(query) || 
                              c.id.toString() === query || 
                              res.candidate.toLowerCase().includes(query);
        return matchesSearch;
    });

    // Summary Chips
    const chipContainer = document.getElementById('mlaFilterChips');
    if (chipContainer) {
        const partyCounts = {};
        data.forEach(c => {
            const res = resultsDraft[c.id];
            const party = res.party;
            partyCounts[party] = (partyCounts[party] || 0) + 1;
        });

        const sortedParties = Object.keys(partyCounts).sort((a, b) => partyCounts[b] - partyCounts[a]);
        chipContainer.innerHTML = sortedParties.map(p => {
            const color = partyColor(p);
            return `
                <div style="display:flex; align-items:center; gap:6px; padding:5px 12px; border-radius:20px; background:${color}15; border:1px solid ${color}35; font-size:0.75rem; font-weight:800; color:${color};">
                    <img src="${partyIcon(p)}" style="width:14px; height:14px; object-fit:contain;" onerror="this.style.display='none'">
                    <span>${p}: ${partyCounts[p]}</span>
                </div>
            `;
        }).join('');
    }

    // Add search listener
    if (searchInput && !searchInput.dataset.listener) {
        searchInput.addEventListener('input', () => window.renderMLAs());
        searchInput.dataset.listener = "true";
    }

    tbl.innerHTML = `
        <thead>
            <tr>
                <th style="width: 50px; text-align: center;">No.</th>
                <th>Constituency</th>
                <th style="text-align: left;">MLA Name</th>
                <th style="text-align: center;">Party</th>
                <th style="text-align: center;">Alliance</th>
                <th style="text-align: right;">Margin</th>
            </tr>
        </thead>
        <tbody>
            ${data.map(c => {
                const res = resultsDraft[c.id];
                const party = res.party;
                const candidate = res.candidate;
                const margin = Number(res.margin).toLocaleString('en-IN');
                const aName = allianceMap[party] || 'Others';
                const allianceColor = allianceColorMap[aName] || 'var(--text-3)';
                const allianceBadge = `<span style="font-size:0.65rem; font-weight:800; padding:3px 10px; border-radius:20px; background:${allianceColor}18; color:${allianceColor}; border:1px solid ${allianceColor}35; white-space:nowrap;">${aName}</span>`;

                return `
                    <tr class="clickable" data-trigger="openConstituency" data-id="${c.id}">
                        <td style="text-align: center; color: var(--text-3); font-weight: 700;">${c.id}</td>
                        <td>
                            <div style="font-weight: 700;">${c.name}</div>
                            <div style="font-size: 0.65rem; color: var(--text-3); font-weight: 600;">${c.district}</div>
                        </td>
                        <td style="font-weight: 800; color: var(--text);">${candidate}</td>
                        <td style="text-align: center;">
                          <div style="display:flex; align-items:center; justify-content:center; gap:5px;">
                            <img src="${partyIcon(party)}" style="width:20px; height:20px; object-fit:contain;" onerror="this.style.display='none'">
                            <span style="color: ${partyColor(party)}; font-weight: 800;">${party}</span>
                          </div>
                        </td>
                        <td style="text-align: center;">${allianceBadge}</td>
                        <td style="text-align: right; font-weight: 700; color: var(--text-2); font-family: var(--font-mono);">${margin}</td>
                    </tr>
                `;
            }).join('') || `<tr><td colspan="6" style="text-align: center; padding: 3rem; color: var(--text-3);">No MLAs found</td></tr>`}
        </tbody>
    `;
};


